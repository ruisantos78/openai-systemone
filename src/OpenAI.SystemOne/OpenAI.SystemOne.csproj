<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>OpenAI.SystemOne</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);OPENAI001</NoWarn>
                
        <!-- Package Metadata -->
        <PackageId>OpenAI.SystemOne</PackageId>
        <Version>1.0.0</Version>
        <Authors>Rui Santos</Authors>
        <Company>Rui Santos</Company>
        <Description>A .NET client for the System One API with OpenAI and .NET Aspire integration, supporting choice, yes/no, and scoring questions.</Description>
        <PackageTags>openai;systemone;aspire;ai;llm;client</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/ruisantos78/openai-systemone</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ruisantos78/openai-systemone</RepositoryUrl>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="OpenAI" Version="2.15.0" />
        <PackageReference Include="Aspire.OpenAI" Version="13.6.4-preview.1.26523.11" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="OpenAI.SystemOne.Test" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <Target Name="GenerateDocs" AfterTargets="Build" Condition="'$(DOCS_GENERATION)' != '1'">
        <Exec Command="dotnet run --file DocsDump.cs -- &quot;$(MSBuildThisFileDirectory)$(OutputPath)$(AssemblyName).xml&quot; &quot;$(MSBuildThisFileDirectory)../../docs/data&quot;"
              WorkingDirectory="$(MSBuildThisFileDirectory)../../scripts"
              EnvironmentVariables="DOCS_GENERATION=1"
              StandardOutputImportance="Low" />
    </Target>

</Project>
